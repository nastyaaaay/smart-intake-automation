{
  "name": "Smart Intake — status bot",
  "nodes": [
    {
      "parameters": {
        "content": "## Настройка перед запуском\n1. Подключите тот же Telegram Bot Token в обеих Telegram нодах.\n2. Подключите тот же Google Sheets credential + ID таблицы в ноде \"Find Lead\".\n3. Запустите n8n с переменной окружения `MANAGER_CHAT_ID=<chat_id менеджера>` (нода \"Check Authorized\" сверяет её с chat_id написавшего боту — без совпадения запрос отклоняется, чтобы посторонний не мог узнать статус чужой заявки по угаданному id).\n4. Активируйте workflow. В Telegram напишите боту: `/status <id>` (id — из колонки id в таблице / из уведомления менеджеру).",
        "height": 300,
        "width": 380
      },
      "id": "sticky-setup-bot",
      "name": "Sticky Note: Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, -160]
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "node-telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-400, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-authorized",
              "leftValue": "={{$json.message.chat.id}}",
              "rightValue": "={{$env.MANAGER_CHAT_ID}}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "node-check-authorized",
      "name": "Check Authorized",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-270, 260]
    },
    {
      "parameters": {
        "errorMessage": "Unauthorized: chat_id does not match MANAGER_CHAT_ID"
      },
      "id": "node-auth-reject-bot",
      "name": "Unauthorized",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [-270, 420]
    },
    {
      "parameters": {
        "jsCode": "const text = ($json.message && $json.message.text) || '';\nconst chatId = $json.message.chat.id;\nconst parts = text.trim().split(/\\s+/);\n\nif (parts[0] !== '/status' || !parts[1]) {\n  return [{\n    json: {\n      chatId,\n      valid: false,\n      replyText: 'Использование: /status <id заявки>'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    chatId,\n    valid: true,\n    leadId: parts[1]\n  }\n}];"
      },
      "id": "node-parse-command",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{$json.valid}}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "node-if-valid",
      "name": "Valid Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [120, 260]
    },
    {
      "parameters": {
        "operation": "lookup",
        "documentId": {
          "mode": "id",
          "value": "PASTE_YOUR_SPREADSHEET_ID_HERE"
        },
        "sheetName": {
          "mode": "name",
          "value": "Sheet1"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "id",
              "lookupValue": "={{$json.leadId}}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-sheets-lookup",
      "name": "Find Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [380, 160]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chatId = $('Parse Command').item.json.chatId;\nconst leadId = $('Parse Command').item.json.leadId;\n\nif (items.length === 0) {\n  return [{ json: { chatId, replyText: `Заявка с id ${leadId} не найдена.` } }];\n}\n\nconst lead = items[0].json;\nconst replyText = [\n  `Заявка #${lead.id}`,\n  `Клиент: ${lead.name}`,\n  `Категория: ${lead.category} | Приоритет: ${lead.priority}`,\n  `Статус: ${lead.status}`,\n  `Суть: ${lead.summary}`\n].join('\\n');\n\nreturn [{ json: { chatId, replyText } }];"
      },
      "id": "node-format-reply",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 160]
    },
    {
      "parameters": {
        "chatId": "={{$json.chatId}}",
        "text": "={{$json.replyText}}",
        "additionalFields": {}
      },
      "id": "node-telegram-reply-found",
      "name": "Reply with Status",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 160]
    },
    {
      "parameters": {
        "chatId": "={{$json.chatId}}",
        "text": "={{$json.replyText}}",
        "additionalFields": {}
      },
      "id": "node-telegram-reply-usage",
      "name": "Reply with Usage",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [380, 400]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Check Authorized", "type": "main", "index": 0 }]]
    },
    "Check Authorized": {
      "main": [
        [{ "node": "Parse Command", "type": "main", "index": 0 }],
        [{ "node": "Unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "Parse Command": {
      "main": [[{ "node": "Valid Command?", "type": "main", "index": 0 }]]
    },
    "Valid Command?": {
      "main": [
        [{ "node": "Find Lead", "type": "main", "index": 0 }],
        [{ "node": "Reply with Usage", "type": "main", "index": 0 }]
      ]
    },
    "Find Lead": {
      "main": [[{ "node": "Format Reply", "type": "main", "index": 0 }]]
    },
    "Format Reply": {
      "main": [[{ "node": "Reply with Status", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
